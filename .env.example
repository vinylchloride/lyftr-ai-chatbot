# Copy this file to .env and replace both placeholders with separate Google AI Studio API keys.
LLM_API_KEYS=replace_with_first_provider_key,replace_with_second_provider_key
LLM_MODEL=gemini/gemini-3.6-flash
PORT=8000
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Use the conversation history when answering.
CACHE_TTL_SECONDS=3600
VITE_API_BASE_URL=http://localhost:8000
